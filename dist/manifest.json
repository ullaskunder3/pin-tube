{
  "manifest_version": 3,
  "name": "Pin-Tube",
  "version": "1.3",
  "description": "Hide Shorts, remove tags, and pin your currently watching videos directly to the top of your YouTube homepage.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pinned.html", "welcome.html"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
